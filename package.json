{
  "name": "canonical-scripture-study",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build:study": "node tools/build.mjs study",
    "build:control": "node tools/build.mjs control",
    "build": "npm run build:study && npm run build:control && npm run build:shared",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.workers.json",
    "test": "npm run test:typescript && npm run test:python",
    "check": "npm run typecheck && npm run check:boundaries && npm run check:python && npm test && npm run check:repository && npm run build",
    "build:shared": "node tools/build.mjs shared",
    "check:boundaries": "node tools/check-boundaries.mjs && node tools/run-python.mjs boundaries",
    "test:typescript": "node --test \"tests/**/*.test.ts\"",
    "test:python": "node tools/run-python.mjs test",
    "check:python": "node tools/run-python.mjs import",
    "check:repository": "node tools/run-python.mjs repository"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261106.1",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
