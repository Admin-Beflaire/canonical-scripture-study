{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:css:aid-entry-records:1",
  "title": "Language-aid entry records",
  "$defs": {
    "aid_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_id",
        "entry",
        "kind",
        "entry_key",
        "lookup_key",
        "byte_offset",
        "byte_length",
        "sha256"
      ],
      "properties": {
        "output_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\uD800-\\uDFFF]*$"
        },
        "entry": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "kind": {
          "enum": [
            "lexicon_entry",
            "grammar_expansion",
            "proper_name"
          ]
        },
        "entry_key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\uD800-\\uDFFF]*$"
        },
        "lookup_key": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\uD800-\\uDFFF]*$"
            }
          ]
        },
        "byte_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
