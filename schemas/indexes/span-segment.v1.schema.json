{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:css:span-segment:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "span_id",
    "segment_ordinal",
    "source_revision_id",
    "kind",
    "start_order",
    "end_order"
  ],
  "properties": {
    "span_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\uD800-\\uDFFF]*$"
    },
    "segment_ordinal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "source_revision_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\uD800-\\uDFFF]*$"
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\uD800-\\uDFFF]*$"
    },
    "start_order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "end_order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
