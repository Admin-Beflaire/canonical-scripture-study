{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:css:native-reference:1",
  "title": "Native reference",
  "description": "Exact source-revision and coordinate basis with ordered linear native segments. Offsets are interpreted only by the identified coordinate profile; source bounds require semantic checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_revision_id",
    "coordinate_version",
    "segments"
  ],
  "properties": {
    "schema_version": {
      "const": "native-reference/1"
    },
    "source_revision_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\uD800-\\uDFFF]*$"
    },
    "coordinate_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\uD800-\\uDFFF]*$"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit_id",
          "start",
          "end"
        ],
        "properties": {
          "unit_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\uD800-\\uDFFF]*$"
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    }
  }
}
