{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:css:reader-reference-catalogue:1",
  "title": "Reader reference catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reader_scheme_version",
    "basis",
    "books",
    "extensions"
  ],
  "properties": {
    "reader_scheme_version": {
      "type": "string",
      "pattern": "^nrsva/[1-9][0-9]*$"
    },
    "basis": {
      "type": "object"
    },
    "books": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "book_id",
          "name",
          "aliases",
          "chapter_count",
          "last_verses"
        ],
        "properties": {
          "book_id": {
            "type": "string",
            "pattern": "^[1-4]?[A-Z][A-Za-z0-9]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\uD800-\\uDFFF]*$"
          },
          "aliases": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\uD800-\\uDFFF]*$"
            }
          },
          "chapter_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "last_verses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "first_verse_overrides": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[1-9][0-9]*$"
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    "extensions": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "book",
          "basis",
          "owner_approval_ref"
        ],
        "properties": {
          "book": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "book_id",
              "name",
              "aliases",
              "chapter_count",
              "last_verses"
            ],
            "properties": {
              "book_id": {
                "type": "string",
                "pattern": "^[1-4]?[A-Z][A-Za-z0-9]*$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\uD800-\\uDFFF]*$"
              },
              "aliases": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\uD800-\\uDFFF]*$"
                }
              },
              "chapter_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "last_verses": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "first_verse_overrides": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[1-9][0-9]*$"
                },
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              }
            }
          },
          "basis": {
            "type": "object"
          },
          "owner_approval_ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\uD800-\\uDFFF]*$"
          }
        }
      }
    }
  }
}
