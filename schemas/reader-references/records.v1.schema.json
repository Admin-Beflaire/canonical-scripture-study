{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:css:reader-reference-records:1",
  "title": "Reader reference records",
  "$defs": {
    "reader_reference_base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "output_id",
        "source_revision_id",
        "reader_scheme_version",
        "native_scheme_version",
        "checked_extent_json",
        "basis_json"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\uD800-\\uDFFF]*$"
        },
        "output_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\uD800-\\uDFFF]*$"
        },
        "source_revision_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\uD800-\\uDFFF]*$"
        },
        "reader_scheme_version": {
          "type": "string",
          "pattern": "^nrsva/[1-9][0-9]*$"
        },
        "native_scheme_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\uD800-\\uDFFF]*$"
        },
        "checked_extent_json": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ranges"
          ],
          "properties": {
            "ranges": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "book_id",
                  "chapter",
                  "first_verse",
                  "last_verse"
                ],
                "properties": {
                  "book_id": {
                    "type": "string",
                    "pattern": "^[1-4]?[A-Z][A-Za-z0-9]*$"
                  },
                  "chapter": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "first_verse": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "last_verse": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                }
              }
            }
          }
        },
        "basis_json": {
          "type": "object"
        }
      }
    },
    "reader_reference_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "output_id",
        "source_revision_id",
        "reader_scheme_version",
        "reader_ref",
        "span_id",
        "role",
        "ordinal",
        "status",
        "basis_json",
        "gap_reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\uD800-\\uDFFF]*$"
        },
        "output_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\uD800-\\uDFFF]*$"
        },
        "source_revision_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\uD800-\\uDFFF]*$"
        },
        "reader_scheme_version": {
          "type": "string",
          "pattern": "^nrsva/[1-9][0-9]*$"
        },
        "reader_ref": {
          "type": "string",
          "pattern": "^[1-4]?[A-Z][A-Za-z0-9]*\\.[1-9][0-9]*\\.[1-9][0-9]*$"
        },
        "span_id": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\uD800-\\uDFFF]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "enum": [
            "numbered_text",
            "superscription"
          ]
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "status": {
          "enum": [
            "exact",
            "partial",
            "reordered",
            "composite",
            "ambiguous",
            "missing",
            "unresolved"
          ]
        },
        "basis_json": {
          "type": "object"
        },
        "gap_reason": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\uD800-\\uDFFF]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "ambiguous",
                  "missing",
                  "unresolved"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "span_id": {
                "type": "null"
              },
              "gap_reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\uD800-\\uDFFF]*$"
              }
            }
          },
          "else": {
            "properties": {
              "span_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\uD800-\\uDFFF]*$"
              },
              "gap_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "superscription"
              }
            }
          },
          "then": {
            "properties": {
              "reader_ref": {
                "type": "string",
                "pattern": "\\.1$"
              }
            }
          }
        }
      ]
    }
  }
}
